{
    "manifest_version": 3,
    "name": "VSkin",
    "version": "1.0.0",
    "description": "VSkin - Steam inventory scanner",
    "background": {
        "service_worker": "background/index.js"
    },
    "content_scripts": [
        {
            "matches": ["*://steamcommunity.com/*/inventory*"],
            "js": ["content/inventory.js"],
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "storage"
    ],
    "icons": {
        "128": "assets/img/logo_128x128.png"
    },
    "host_permissions": [
        "https://api.vskin.gg/*"
    ],
    "web_accessible_resources": [
        {
            "resources": ["assets/img/logo_128x128.png"],
            "matches": ["http://localhost/*", "https://*.vskin.gg/*"]
        }
    ]
}
