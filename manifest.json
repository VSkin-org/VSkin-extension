{
    "manifest_version": 3,
    "name": "VSkin",
    "version": "1.1.1",
    "description": "VSkin - Steam inventory scanner",
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "128": "assets/img/logo_128x128.png"
        }
    },
"permissions": [
        "storage",
        "cookies"
    ],
    "icons": {
        "128": "assets/img/logo_128x128.png"
    },
    "host_permissions": [
        "https://api.vskin.gg/*",
        "https://steamcommunity.com/*"
    ],
    "web_accessible_resources": [
        {
            "resources": ["assets/img/logo_128x128.png"],
            "matches": ["https://vskin.gg/*"]
        }
    ]
}
